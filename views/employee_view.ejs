<%- include('partials/header') %>
<div class="page-head">
  <h1><%= emp.name %> <%= emp.surname %></h1>
  <% if (['admin','partner','manager'].includes(user.role)) { %>
    <a class="btn" href="/employees/<%= emp.id %>/edit">Редактировать</a>
  <% } %>
</div>
<p class="muted"><%= ROLE_LABELS[emp.role] %> · <%= emp.phone %> · <%= emp.email %></p>
<p>Бизнес: <%= biz ? biz.name : '—' %></p>

<% const done = tasks.filter(t => t.status==='completed').length; %>
<div class="stats-grid">
  <div class="stat-card"><div class="stat-num"><%= tasks.length %></div><div>Всего задач</div></div>
  <div class="stat-card stat-green"><div class="stat-num"><%= done %></div><div>Выполнено</div></div>
  <div class="stat-card stat-red"><div class="stat-num"><%= tasks.length - done %></div><div>Не выполнено</div></div>
  <div class="stat-card"><div class="stat-num"><%= tasks.length ? Math.round(done/tasks.length*100) : 0 %>%</div><div>Процент выполнения</div></div>
</div>

<h2>Задачи</h2>
<table class="table">
<thead><tr><th>Дата</th><th>Задача</th><th>План</th><th>Факт</th><th>%</th><th>Статус</th></tr></thead>
<tbody>
<% tasks.forEach(t => { %>
<tr><td><%= t.task_date %></td><td><a href="/tasks/<%= t.id %>"><%= t.title %></a></td><td><%= t.planned_value %> <%= t.unit %></td><td><%= t.actual_value %></td><td><%= t.completion_percent %>%</td><td><span class="badge badge-<%= STATUS_COLORS[t.status] %>"><%= STATUS_LABELS[t.status] %></span></td></tr>
<% }) %>
</tbody>
</table>
<%- include('partials/footer') %>
