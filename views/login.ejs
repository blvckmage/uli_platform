<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Вход — ULI Platform</title>
<link rel="stylesheet" href="/style.css">
</head>
<body class="login-page">
<div class="login-box">
  <h1>ULI Platform</h1>
  <p class="muted">Управление бизнесами и сотрудниками</p>
  <% if (error) { %><div class="error"><%= error %></div><% } %>
  <form method="post" action="/login">
    <label>Логин или email
      <input type="text" name="email" required autofocus>
    </label>
    <label>Пароль
      <input type="password" name="password" required>
    </label>
    <button type="submit" class="btn-primary">Войти</button>
  </form>
</div>
<script>
(function(){
  var inp = document.querySelector('input[name="email"]');
  if (!inp) return;
  function fmt(d){
    d = (d||'').replace(/\D/g,'');
    if (d.length && d[0] === '8') d = '7' + d.slice(1);
    if (d.length && d[0] !== '7') return null;
    d = d.slice(0,11);
    if (d.length <= 1) return '7';
    if (d.length <= 4) return '7(' + d.slice(1);
    if (d.length <= 7) return '7(' + d.slice(1,4) + ') - ' + d.slice(4);
    return '7(' + d.slice(1,4) + ') - ' + d.slice(4,7) + ' - ' + d.slice(7,11);
  }
  inp.addEventListener('input', function(){
    var v = inp.value.trim();
    if (/^[\d()+\-\s]+$/.test(v) && v.replace(/\D/g,'').length >= 2) {
      var f = fmt(v); if (f) inp.value = f;
    }
  });
})();
</script>
</body>
</html>
