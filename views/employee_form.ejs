<%- include('partials/header') %>
<h1><%= item.id ? 'Редактировать' : 'Добавить' %> сотрудника</h1>
<form method="post" action="<%= action %>" class="form">
  <label>Имя<input name="name" value="<%= item.name || '' %>" required></label>
  <label>Фамилия<input name="surname" value="<%= item.surname || '' %>"></label>
  <label>Телефон (логин)
    <input name="phone" id="phone-input" value="<%= item.phone || '' %>" placeholder="7(XXX) - XXX - XXXX" required>
    <small class="muted">Сотрудник будет входить в систему по этому номеру</small>
  </label>
  <label>Email (необязательно)<input name="email" value="<%= item.email || '' %>"></label>
  <label>Пароль <%= item.id ? '(оставьте пустым, чтобы не менять)' : '' %>
    <input type="password" name="password" <%= item.id ? '' : 'required' %>>
  </label>
  <label>Роль
    <select name="role">
      <% Object.entries(ROLE_LABELS).forEach(([k,v]) => { if (k==='admin' && user.role!=='admin') return; %>
        <option value="<%= k %>" <%= item.role===k?'selected':'' %>><%= v %></option>
      <% }) %>
    </select>
  </label>
  <label>Бизнес
    <select name="business_id">
      <option value="">— не выбран —</option>
      <% businesses.forEach(b => { %><option value="<%= b.id %>" <%= item.business_id===b.id?'selected':'' %>><%= b.name %></option><% }) %>
    </select>
  </label>
  <label>Статус
    <select name="status">
      <option value="active" <%= item.status==='active'?'selected':'' %>>Активен</option>
      <option value="disabled" <%= item.status==='disabled'?'selected':'' %>>Временно отключен</option>
      <option value="fired" <%= item.status==='fired'?'selected':'' %>>Уволен</option>
    </select>
  </label>
  <button class="btn-primary" type="submit">Сохранить</button>
</form>
<script>
(function(){
  var inp = document.getElementById('phone-input');
  if (!inp) return;
  function fmt(v){
    var d = (v||'').replace(/\D/g,'');
    if (d.length && d[0] === '8') d = '7' + d.slice(1);
    if (d.length && d[0] !== '7') d = '7' + d;
    d = d.slice(0,11);
    if (d.length <= 1) return '7';
    if (d.length <= 4) return '7(' + d.slice(1);
    if (d.length <= 7) return '7(' + d.slice(1,4) + ') - ' + d.slice(4);
    return '7(' + d.slice(1,4) + ') - ' + d.slice(4,7) + ' - ' + d.slice(7,11);
  }
  inp.addEventListener('focus', function(){ if (!inp.value) inp.value = '7('; });
  inp.addEventListener('input', function(){ inp.value = fmt(inp.value); });
})();
</script>
<%- include('partials/footer') %>
