<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ULI Platform</title>
<link rel="stylesheet" href="/style.css">
</head>
<body>
<button class="menu-toggle" onclick="document.body.classList.toggle('menu-open')">☰ Меню</button>
<aside class="sidebar">
  <div class="brand">ULI Platform</div>
  <nav>
    <a href="/" class="<%= path === '/' ? 'active' : '' %>">🏠 Главная</a>
    <% if (['admin'].includes(user.role)) { %>
      <a href="/businesses" class="<%= path.startsWith('/businesses') ? 'active' : '' %>">🏢 Бизнесы</a>
    <% } %>
    <% if (['admin','manager'].includes(user.role)) { %>
      <a href="/employees" class="<%= path.startsWith('/employees') ? 'active' : '' %>">👥 Сотрудники</a>
    <% } %>
    <a href="/tasks" class="<%= path.startsWith('/tasks') ? 'active' : '' %>">📋 Задачи</a>
    <% if (['manager'].includes(user.role)) { %>
      <a href="/my-tasks" class="<%= path === '/my-tasks' ? 'active' : '' %>">✅ Мои задачи</a>
    <% } %>
  <!-- Финансы удалены -->
  <% if (['admin','manager'].includes(user.role)) { %>
      <a href="/reports" class="<%= path.startsWith('/reports') ? 'active' : '' %>">📊 Отчеты</a>
      <a href="/analytics" class="<%= path.startsWith('/analytics') ? 'active' : '' %>">📈 Аналитика</a>
    <% } %>
    <a href="/notifications" class="<%= path.startsWith('/notifications') ? 'active' : '' %>">🔔 Уведомления</a>
  </nav>
  <div class="user-block">
    <div><strong><%= user.name %> <%= user.surname %></strong></div>
    <small><%= ROLE_LABELS[user.role] || user.role %></small>
    <a href="/logout" class="logout">Выйти</a>
  </div>
</aside>
<main class="content">
