<%- include('partials/header') %>
<h1>Мои задачи</h1>
<%
const sections = [
  ['На сегодня', today],
  ['На завтра', tomorrow],
  ['Будущие', future],
  ['Просроченные', overdue],
  ['Выполненные', done]
];
%>
<% sections.forEach(([label, list]) => { %>
  <h2><%= label %> (<%= list.length %>)</h2>
  <% if (!list.length) { %><p class="muted">Нет задач</p><% } else { %>
    <table class="table">
    <thead><tr><th>Дата</th><th>Задача</th><th>План</th><th>Факт</th><th>%</th><th>Статус</th></tr></thead>
    <tbody>
    <% list.forEach(t => { %>
      <tr>
        <td><%= t.task_date %> <%= t.deadline_time %></td>
        <td><a href="/tasks/<%= t.id %>"><%= t.title %></a></td>
        <td><%= t.planned_value %> <%= t.unit %></td>
        <td><%= t.actual_value %></td>
        <td><%= t.completion_percent %>%</td>
        <td><span class="badge badge-<%= STATUS_COLORS[t.status] %>"><%= STATUS_LABELS[t.status] %></span></td>
      </tr>
    <% }) %>
    </tbody>
    </table>
  <% } %>
<% }) %>
<%- include('partials/footer') %>
